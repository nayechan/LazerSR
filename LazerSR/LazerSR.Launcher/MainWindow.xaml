<Window x:Class="LazerSR.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LazerSR"
        Height="420"
        Width="480"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="PillToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track"
                                    CornerRadius="11"
                                    Background="#555"
                                    Width="44" Height="22"/>
                            <Ellipse x:Name="Thumb"
                                     Width="18" Height="18"
                                     Fill="White"
                                     HorizontalAlignment="Left"
                                     Margin="2,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#3A8"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="24,0,0,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock Text="LazerSR"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,12"/>

        <DockPanel Margin="0,0,0,6">
            <Button DockPanel.Dock="Right"
                    Content="Browse"
                    Width="72"
                    Margin="6,0,0,0"
                    Click="BrowseButton_Click"/>
            <TextBox x:Name="InstallPathTextBox"
                     VerticalContentAlignment="Center"/>
        </DockPanel>

        <DockPanel Margin="0,0,0,6">
            <Button DockPanel.Dock="Left"
                    Content="Launch osu!"
                    Width="110"
                    Margin="0,0,8,0"
                    Click="LaunchButton_Click"/>
            <Button DockPanel.Dock="Right"
                    Content="Reconnect"
                    Width="88"
                    IsEnabled="False"
                    x:Name="ReconnectButton"
                    Click="ReconnectButton_Click"/>
            <TextBlock x:Name="PipeStatusTextBlock"
                       VerticalAlignment="Center"
                       Text="Disconnected"/>
        </DockPanel>

        <TextBlock x:Name="StatusTextBlock"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"
                   Foreground="#AAA"
                   FontSize="11"/>

        <Separator Margin="0,4,0,8"/>

        <DockPanel Margin="0,2">
            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource PillToggle}"
                          x:Name="SunnySRToggle"
                          IsEnabled="False"
                          Checked="FeatureToggle_Changed"
                          Unchecked="FeatureToggle_Changed"
                          Tag="sunny"/>
            <TextBlock Text="sunnySR 표시" VerticalAlignment="Center"/>
        </DockPanel>
        <DockPanel Margin="0,2">
            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource PillToggle}"
                          x:Name="DanToggle"
                          IsEnabled="False"
                          Checked="FeatureToggle_Changed"
                          Unchecked="FeatureToggle_Changed"
                          Tag="dan"/>
            <TextBlock Text="Dan 수치 표시" VerticalAlignment="Center"/>
        </DockPanel>
        <DockPanel Margin="0,2">
            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource PillToggle}"
                          x:Name="GraphToggle"
                          IsEnabled="False"
                          Checked="FeatureToggle_Changed"
                          Unchecked="FeatureToggle_Changed"
                          Tag="graph"/>
            <TextBlock Text="난이도 그래프" VerticalAlignment="Center"/>
        </DockPanel>
        <DockPanel Margin="0,2">
            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource PillToggle}"
                          x:Name="HoneyToggle"
                          IsEnabled="False"
                          Checked="FeatureToggle_Changed"
                          Unchecked="FeatureToggle_Changed"
                          Tag="honey"/>
            <TextBlock Text="Honey Spot" VerticalAlignment="Center"/>
        </DockPanel>
        <DockPanel Margin="0,2">
            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource PillToggle}"
                          x:Name="MsdToggle"
                          IsEnabled="False"
                          Checked="FeatureToggle_Changed"
                          Unchecked="FeatureToggle_Changed"
                          Tag="msd"/>
            <TextBlock Text="MSD 스킬셋" VerticalAlignment="Center"/>
        </DockPanel>
    </StackPanel>
</Window>
